          </ownedEntities>
          <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="8b0f09ab-73ba-412d-b45e-a567dc76e676"
              name="Tête" description="&lt;table>&#xA;&#x9;&lt;thead>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;th>Nom de l&amp;rsquo;activit&amp;eacute;&lt;/th>&#xA;&#x9;&#x9;&#x9;&lt;th>Description&lt;/th>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/thead>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Recevoir les ordres utilisateur&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Capturer les commandes vocales ou tactiles de l&amp;rsquo;utilisateur.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Analyser et interpr&amp;eacute;ter les intentions&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Traiter la voix, les menus ou les gestes pour g&amp;eacute;n&amp;eacute;rer des ordres exploitables.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Transmettre les ordres au robot&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Envoyer les consignes de mission, de vitesse ou de mode au contr&amp;ocirc;leur du robot.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Afficher l&amp;rsquo;&amp;eacute;tat du syst&amp;egrave;me&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Pr&amp;eacute;senter &amp;agrave; l&amp;rsquo;utilisateur la t&amp;eacute;l&amp;eacute;m&amp;eacute;trie (angle, tension, temp&amp;eacute;rature, mode actif, fautes).&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>G&amp;eacute;rer le mode automatique&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Calculer ou piloter les trajectoires en mode autonome.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Notifier les alertes et &amp;eacute;v&amp;eacute;nements&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Produire des messages audio/visuels en cas d&amp;rsquo;erreur ou d&amp;rsquo;&amp;eacute;v&amp;eacute;nement critique.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Dialoguer avec l&amp;rsquo;utilisateur&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Fournir un retour vocal, visuel ou textuel interactif.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Journaliser les &amp;eacute;v&amp;eacute;nements&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Enregistrer les logs du robot et les interactions utilisateur pour diagnostic.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
