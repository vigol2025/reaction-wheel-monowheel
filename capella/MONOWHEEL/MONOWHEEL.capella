          </ownedEntities>
          <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="e2676cdb-f018-49a2-a89d-8a524ebc10ce"
              name="Telecomande/manette" description="&lt;table>&#xA;&#x9;&lt;thead>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;th>Nom de l&amp;rsquo;activit&amp;eacute;&lt;/th>&#xA;&#x9;&#x9;&#x9;&lt;th>Description&lt;/th>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/thead>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Capturer les actions utilisateur&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Lire les entr&amp;eacute;es des joysticks, g&amp;acirc;chettes et boutons.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Traduire les actions en signaux de commande&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Convertir les mouvements du pilote en trames num&amp;eacute;riques (vitesse, direction).&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Transmettre les commandes au robot&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Envoyer les signaux radio ou Bluetooth au r&amp;eacute;cepteur du robot.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Recevoir les retours du robot (si bidirectionnelle)&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Afficher l&amp;rsquo;&amp;eacute;tat de la liaison, le niveau de batterie ou les erreurs via LEDs.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>G&amp;eacute;rer la liaison radio&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Maintenir la connexion, g&amp;eacute;rer les pertes de signal ou fail-safes.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Notifier l&amp;rsquo;utilisateur&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Indiquer les alertes par vibrations, sons ou LEDs.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Basculer les modes&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Permettre &amp;agrave; l&amp;rsquo;utilisateur de changer de mode ou de vitesse via un bouton d&amp;eacute;di&amp;eacute;.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
