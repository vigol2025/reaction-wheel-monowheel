        </ownedLogicalComponents>
        <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
            id="4ffd92e0-1f5e-46ec-b2c2-fcd81845e4f4" name="Utilisateur" description="&lt;table>&#xA;&#x9;&lt;thead>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;th>Nom de l&amp;rsquo;activit&amp;eacute;&lt;/th>&#xA;&#x9;&#x9;&#x9;&lt;th>Description&lt;/th>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/thead>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Allumer et initialiser le syst&amp;egrave;me&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>D&amp;eacute;marrer la t&amp;ecirc;te, le robot et v&amp;eacute;rifier la disponibilit&amp;eacute; de la manette.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>S&amp;eacute;lectionner le mode de fonctionnement&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Choisir entre pilotage manuel ou automatique via l&amp;rsquo;IHM.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Donner des ordres de mission&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>D&amp;eacute;finir les objectifs (trajet, vitesse, orientation, arr&amp;ecirc;t).&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Piloter manuellement le robot&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Utiliser la manette pour contr&amp;ocirc;ler le mouvement et l&amp;rsquo;&amp;eacute;quilibre.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Superviser l&amp;rsquo;&amp;eacute;tat du robot&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Observer les retours visuels ou sonores et corriger si besoin.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Interagir avec la t&amp;ecirc;te&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Dialoguer par voix ou tactile pour changer des param&amp;egrave;tres ou consulter des infos.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Intervenir en cas d&amp;rsquo;urgence&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Appuyer sur E-stop ou couper l&amp;rsquo;alimentation en cas de danger.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Observer l&amp;rsquo;environnement&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>&amp;Eacute;valuer la s&amp;eacute;curit&amp;eacute; de la zone et d&amp;eacute;tecter les obstacles ou risques.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;"
            actor="true">
          <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
              id="8384619f-1e5e-4bbf-97dd-40b60ad1ceaa" targetElement="#97f1efae-f4af-4b4a-99bd-b65c9e252358"
              sourceElement="#fa424629-d7ec-4e11-a566-2b8bc395ac24"/>
