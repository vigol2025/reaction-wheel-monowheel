      <ownedFunctionPkg xsi:type="org.polarsys.capella.core.data.oa:OperationalActivityPkg"
          id="5251c0db-f79a-4c80-9948-6f7b82acafb9" name="Operational Activities">
        <ownedOperationalActivities xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
            id="b0070f4c-ead7-4b21-82f1-667c9844c534" name="Root Operational Activity">
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="993e7d79-1fae-4c68-986a-2aeb47eb2976" name="S'auto équilibré" summary="Stabilisation (roll/pitch)"
              description="&lt;p>Maintenir l&amp;rsquo;&amp;eacute;quilibre du corps sur un axe roll/pitch &amp;agrave; l&amp;rsquo;aide des reaction wheels et de la roue motrice.&lt;/p>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="4ff6343b-1f0e-4872-b7a4-574f44e01160" name="Recevoir les ordres utilisateur"
              summary="Capturer les commandes vocales ou tactiles de l’utilisateur."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="5b1dd52c-605d-4919-bd81-2ef5cb156202" name="Fournir le support mécanique"
              summary="Offrir la surface de roulement sur laquelle agit le robot (sol, pente, rugosité)."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="738f80be-bc68-44cc-87cd-db09d64f0bc5" name="Allumer et initialiser le système"
              summary="Démarrer la tête, le robot et vérifier la disponibilité de la manette."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="a384e5c4-8a7b-41bc-97a0-14d080195546" name="Capturer les actions utilisateur"
              summary="Lire les entrées des joysticks, gâchettes et boutons."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="f3129884-4c23-43ca-8696-0ec69978f321" name="Surveiller énergie et securité"
              summary="(surchauffe, sous-tension, défaut capteur)"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="5c9931b1-0159-4241-ab15-90b5d588347f" name="Se deplacer" summary="virer/ suivre des consigne"
              description="&lt;p>G&amp;eacute;rer la roue au sol pour avancer, reculer ou tourner selon les consignes.&lt;/p>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="d8b7854e-07f2-40e7-bf85-06b8a33f122e" name="Télémétrie" summary="Rapporter les état et les alertes"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="fa42d481-5ead-4f2a-86e1-8b58dcd60512" name="Executer les modes de pilotage"
              summary="Off, Safe, manu, auto et dégrader"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="36b58ea1-c031-43e8-b3ae-3950fd1a4317" name="Recevoir et interpréter les commandes"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="45bc9972-731d-4ba1-bc09-8a2eb7b98ea7" name="Gérer le mode automatique"
              summary="Calculer ou piloter les trajectoires en mode autonome."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="3704ee48-bd9d-4a89-a4ff-eadc93cc254b" name="Transmettre les ordres au robot"
              summary="Envoyer les consignes de mission, de vitesse ou de mode au contrôleur du robot."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="856cf070-b8df-4727-ad6f-3e5e6441b56d" name="Notifier les alertes et événements"
              summary="Produire des messages audio/visuels en cas d’erreur ou d’événement critique."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="c8a29a88-f65d-4c96-b35a-f867ab3e5adb" name="Dialoguer avec l’utilisateur"
              summary="Fournir un retour vocal, visuel ou textuel interactif."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="ba410df3-49fb-4134-8b29-d49e1d864479" name="Afficher l’état du système"
              summary="Présenter à l’utilisateur la télémétrie (angle, tension, température, mode actif, fautes)."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="b7350229-af3e-4355-bd34-c85a8ffbe9d5" name="Sélectionner le mode de fonctionnement"
              summary="Choisir entre pilotage manuel ou automatique via l’IHM."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="b0179d0d-461a-47b2-9b5b-0030cff44879" name="Donner des ordres de mission"
              summary="Définir les objectifs (trajet, vitesse, orientation, arrêt)."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="fd6a6d17-73f1-429a-b52b-4ddf12773d58" name="Piloter manuellement le robot"
              summary="Utiliser la manette pour contrôler le mouvement et l’équilibre."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="534abb2f-b6ac-4664-a0bc-24cdde415435" name="Superviser l’état du robot"
              summary="Observer les retours visuels ou sonores et corriger si besoin."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="08904e9a-dcb6-4eb3-9906-b473c3be10ba" name="Traduire les actions en signaux de commande"
              summary="Convertir les mouvements du pilote en trames numériques (vitesse, direction)."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="7a0f757e-b94f-4e92-94c7-7d1e53d33150" name="Transmettre les commandes au robot"
              summary="Envoyer les signaux radio ou Bluetooth au récepteur du robot."/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.oa:OperationalActivity"
              id="ff92afd5-f4f2-4888-b79f-d145ddbf9044" name="Basculer les modes"
