          <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="4f539b67-d3a8-4ada-8977-434efbb44cda"
              name="Robot Monowheel" description="&lt;table>&#xA;&#x9;&lt;thead>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;th>Nom de l&amp;rsquo;activit&amp;eacute;&lt;/th>&#xA;&#x9;&#x9;&#x9;&lt;th>Description&lt;/th>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/thead>&#xA;&#x9;&lt;tbody>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Auto-stabiliser le robot&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Maintenir l&amp;rsquo;&amp;eacute;quilibre du corps sur un axe roll/pitch &amp;agrave; l&amp;rsquo;aide des reaction wheels et de la roue motrice.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Assurer la propulsion&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>G&amp;eacute;rer la roue au sol pour avancer, reculer ou tourner selon les consignes.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Recevoir et interpr&amp;eacute;ter les commandes&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Lire les ordres issus de la t&amp;ecirc;te (auto) ou de la manette (manuel).&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Ex&amp;eacute;cuter le mode de pilotage&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>S&amp;eacute;lectionner et appliquer le mode Auto, Manuel ou Safe.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Superviser les &amp;eacute;tats internes&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Surveiller tension, temp&amp;eacute;rature, courant et &amp;eacute;tat des moteurs/ESC.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>Communiquer les &amp;eacute;tats au syst&amp;egrave;me sup&amp;eacute;rieur&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Envoyer t&amp;eacute;l&amp;eacute;m&amp;eacute;trie, diagnostics et alertes vers la t&amp;ecirc;te et/ou la manette.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>R&amp;eacute;agir aux perturbations de l&amp;rsquo;environnement&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Corriger les d&amp;eacute;s&amp;eacute;quilibres dus au sol, aux pentes ou aux chocs.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&#x9;&lt;tr>&#xA;&#x9;&#x9;&#x9;&lt;td>&lt;strong>G&amp;eacute;rer la s&amp;eacute;curit&amp;eacute;&lt;/strong>&lt;/td>&#xA;&#x9;&#x9;&#x9;&lt;td>Arr&amp;ecirc;ter les moteurs ou passer en mode Safe en cas de d&amp;eacute;faut.&lt;/td>&#xA;&#x9;&#x9;&lt;/tr>&#xA;&#x9;&lt;/tbody>&#xA;&lt;/table>&#xA;">
